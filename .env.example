# Copy to .env and adjust. Every value below is the default used by docker-compose.yml.
# OPENAI_API_KEY is the only value you must set for extraction to work.

# Secret used to sign access and refresh JWTs, at least 32 characters; set a long random value outside local demos.
JWT_SECRET=dev-insecure-jwt-secret-change-me-please
# JWT signing algorithm: HS256, HS384 or HS512.
JWT_ALGORITHM=HS256
# Access token lifetime in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds.
REFRESH_TOKEN_TTL_SECONDS=86400
# Absolute lifetime of a refresh-token family in seconds; rotation does not extend it.
REFRESH_FAMILY_MAX_LIFETIME_SECONDS=604800
# Dev only, replace outside local demos: comma-separated "app_id:sha256(app_token)" pairs; the default accepts "demo-app-token".
# Removing an entry revokes that app: its access and refresh tokens are rejected after a restart.
APP_TOKENS=demo:05c7cd5c50922870dcfe86ad612a8a32ff0ae65eb6d7894a0b852403fbf25767

# Neo4j password; also used to initialise the neo4j container and its healthcheck.
NEO4J_PASSWORD=password

# OpenAI API key (required for extraction; the stack starts without it).
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible API; empty means the official OpenAI endpoint.
OPENAI_BASE_URL=
# Chat model for extraction and, unless JUDGE_MODEL is set, duplicate judging (structured outputs).
LLM_MODEL=gpt-4.1-mini
# Vision model for describing PDF images and rendered pages.
VISION_MODEL=gpt-4.1-mini
# Chat model for the duplicate judge only; empty means LLM_MODEL.
JUDGE_MODEL=
# Embedding model for characters and relation types.
EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension; must match the Neo4j vector indexes (use a fresh database after changing it).
EMBEDDING_DIM=1536
# Maximum concurrent LLM requests per process.
LLM_MAX_CONCURRENCY=4
# Timeout of a single LLM request in seconds.
LLM_TIMEOUT_SECONDS=60
# Retries of a failed LLM request inside the OpenAI client.
LLM_MAX_RETRIES=3

# Maximum upload size in bytes.
MAX_UPLOAD_BYTES=20971520

# Maximum characters per extraction chunk.
CHUNK_MAX_CHARS=6000
# Characters of overlap between neighbouring chunks.
CHUNK_OVERLAP_CHARS=500
# Articles that split into more chunks than this fail before any extraction call.
MAX_CHUNKS_PER_ARTICLE=200
# Maximum number of images described by the vision model per PDF.
PDF_MAX_IMAGES=20
# Embedded images with a shorter side below this many pixels are skipped.
PDF_MIN_IMAGE_SIDE=100
# Pages with less text than this are treated as scanned and rendered whole if they have visual content.
PDF_SCANNED_PAGE_MIN_CHARS=50
# DPI used when rendering a whole page for the vision model.
PDF_RENDER_DPI=150
# "auto" renders scanned or graphics-heavy pages; "all_pages" renders every non-blank page.
VISION_MODE=auto
# Minimum number of significant vector drawings for a page to count as graphical.
PDF_DRAWINGS_MIN_COUNT=20
# Minimum share of the page area covered by those drawings for a page to count as graphical.
PDF_DRAWINGS_MIN_AREA_RATIO=0.12

# Number of nearest existing characters considered when deduplicating a new character.
DEDUP_CANDIDATES=5
# Cosine similarity at or above which a candidate is merged without asking the LLM.
DEDUP_AUTO_MERGE_THRESHOLD=0.95
# Cosine similarity at or above which the LLM judge decides whether two characters are the same; at most DEDUP_AUTO_MERGE_THRESHOLD.
DEDUP_JUDGE_THRESHOLD=0.65
# Maximum LLM judge calls per article.
DEDUP_MAX_JUDGE_CALLS_PER_ARTICLE=10
# Minimum cosine similarity for a free-form relation type query to resolve to a known type.
RELATION_TYPE_QUERY_THRESHOLD=0.7
# Lifetime of the graph resolve lock in seconds; must exceed judge calls x LLM timeout.
RESOLVE_LOCK_TIMEOUT_SECONDS=900
# How long article processing waits for the resolve lock, in seconds.
RESOLVE_LOCK_ACQUIRE_TIMEOUT_SECONDS=600
# How long a manual merge request waits for the resolve lock before answering 409, in seconds.
MERGE_LOCK_ACQUIRE_TIMEOUT_SECONDS=10

# Run periodic reconciliation of duplicate characters in the worker.
RECONCILE_ENABLED=false
# Reconciliation interval in minutes (divides 60, or whole hours dividing 24).
RECONCILE_INTERVAL_MINUTES=60
# Characters examined per reconciliation run.
RECONCILE_BATCH_SIZE=200
# Maximum LLM judge calls per reconciliation run.
RECONCILE_MAX_JUDGE_CALLS=50
# Periodically mark articles stuck in processing as failed.
STUCK_SWEEP_ENABLED=true
# Stuck-article sweep interval in minutes (divides 60, or whole hours dividing 24).
STUCK_SWEEP_INTERVAL_MINUTES=10
# Age in seconds after which a pending or processing article counts as stuck; must exceed JOB_TIMEOUT_SECONDS.
STUCK_ARTICLE_AFTER_SECONDS=4200
# ARQ job timeout of the worker in seconds; must exceed RESOLVE_LOCK_ACQUIRE_TIMEOUT_SECONDS + RESOLVE_LOCK_TIMEOUT_SECONDS.
JOB_TIMEOUT_SECONDS=3600
# Attempts per article job; only Neo4j/Redis outages (unavailable, session expired, transient, connection, timeout) are retried.
JOB_MAX_TRIES=3
# Delay in seconds before an article job is retried after a Neo4j/Redis outage.
JOB_RETRY_DELAY_SECONDS=30

# Set by docker-compose.yml for the container topology, do not override here:
# NEO4J_USER=neo4j (the neo4j container only creates that user), NEO4J_URI=bolt://neo4j:7687 (Neo4j Bolt URI), REDIS_URL=redis://redis:6379/0 (queue, locks, refresh tokens),
# JOB_QUEUE=arq ("arq" worker or "inline" in-process), UPLOAD_DIR=/data/uploads (shared uploads volume).

# Log level.
LOG_LEVEL=INFO
# Emit JSON logs (true) or human-readable console logs (false).
LOG_JSON=true

# docker-compose only: host port of the API.
API_PORT=8000
# docker-compose only: host port of the Neo4j browser (bound to 127.0.0.1).
NEO4J_HTTP_PORT=7474
# docker-compose only: host port of Neo4j Bolt (bound to 127.0.0.1).
NEO4J_BOLT_PORT=7687
# docker-compose only: Neo4j JVM heap limit.
NEO4J_HEAP_MAX_SIZE=512m
# docker-compose only: Neo4j page cache size.
NEO4J_PAGECACHE_SIZE=256m
